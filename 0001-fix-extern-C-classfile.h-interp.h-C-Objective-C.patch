native_uikit.mm — Objective-C++ (.mm), включает эти заголовки напрямую.
Без extern "C" компилятор ожидал C++-мангленные имена функций, которых
не было в classfile.o/interp.o (собраны как чистый C) — ld не находил
classfile_load/classfile_free/interp_run_static.
---
 testos/vm/classfile.h | 8 ++++++++
 testos/vm/interp.h    | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/testos/vm/classfile.h b/testos/vm/classfile.h
index 7e6ca56..447d863 100644
--- a/testos/vm/classfile.h
+++ b/testos/vm/classfile.h
@@ -10,6 +10,10 @@
 #include <stdint.h>
 #include <stddef.h>
 
+#ifdef __cplusplus
+extern "C" {
+#endif
+
 typedef enum {
     CP_UTF8 = 1,
     CP_INTEGER = 3,
@@ -90,4 +94,8 @@ const char *cf_class_name(const class_file_t *cf, uint16_t class_index);
 /* Найти метод по имени+дескриптору (NULL если нет). */
 method_info_t *cf_find_method(const class_file_t *cf, const char *name, const char *descriptor);
 
+#ifdef __cplusplus
+}
+#endif
+
 #endif
diff --git a/testos/vm/interp.h b/testos/vm/interp.h
index 18ebab6..06ccaae 100644
--- a/testos/vm/interp.h
+++ b/testos/vm/interp.h
@@ -12,9 +12,17 @@
 
 #include "classfile.h"
 
+#ifdef __cplusplus
+extern "C" {
+#endif
+
 /* Выполняет статический метод с заданным именем+дескриптором (аргументов
  * пока не передаём — не нужно для M1: main() всегда "()V"/"([Ljava/lang/String;)V").
  * Возвращает 0 при успехе, -1 при ошибке рантайма (печатает причину в stderr). */
 int interp_run_static(class_file_t *cf, const char *method_name, const char *descriptor);
 
+#ifdef __cplusplus
+}
+#endif
+
 #endif
-- 
2.43.0

