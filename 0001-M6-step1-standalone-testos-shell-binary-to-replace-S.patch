--- /dev/null
+++ b/testos/shell/Makefile
@@ -0,0 +1,11 @@
+TARGET := iphone:clang:12.4:6.0
+ARCHS = armv7
+include $(THEOS)/makefiles/common.mk
+
+APPLICATION_NAME = testos-shell
+testos-shell_FILES = main.mm ../vm/classfile.c ../vm/interp.c ../native-bridge/native_uikit.mm
+testos-shell_CFLAGS = -fobjc-arc -I../vm -I../native-bridge
+testos-shell_FRAMEWORKS = UIKit CoreGraphics QuartzCore Foundation
+testos-shell_CODESIGN_FLAGS = -Sentitlements.xml
+
+include $(THEOS_MAKE_PATH)/application.mk
