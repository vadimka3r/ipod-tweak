diff --git a/testos/shell/main.mm b/testos/shell/main.mm
new file mode 100644
index 0000000..b6fd04b
--- /dev/null
+++ b/testos/shell/main.mm
@@ -0,0 +1,40 @@
+/*
+ * main.mm — точка входа standalone-бинарника, который launchd запускает
+ * ВМЕСТО настоящего SpringBoard (мы физически подменяем файл по пути
+ * /System/Library/CoreServices/SpringBoard.app/SpringBoard, сам launchd
+ * job/plist не трогаем).
+ *
+ * Это НЕ твик — сюда не грузится MobileSubstrate, это первый процесс,
+ * который launchd поднимает после ядра для пользовательского интерфейса.
+ * Соответственно, никакого SBUIController/SpringBoard.app рядом уже нет —
+ * весь экран полностью наш с первого кадра.
+ */
+#import <UIKit/UIKit.h>
+#include "../vm/classfile.h"
+#include "../vm/interp.h"
+#include "native_uikit.h"
+
+@interface TestOSAppDelegate : NSObject <UIApplicationDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+@implementation TestOSAppDelegate
+
+- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
+    self.window = [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds];
+    self.window.backgroundColor = [UIColor blackColor];
+    [self.window makeKeyAndVisible];
+
+    testos_uikit_set_root_view(self.window);
+    testos_vm_start("/Library/TestOS/Desktop.class");
+
+    return YES;
+}
+
+@end
+
+int main(int argc, char *argv[]) {
+    @autoreleasepool {
+        return UIApplicationMain(argc, argv, nil, NSStringFromClass([TestOSAppDelegate class]));
+    }
+}
